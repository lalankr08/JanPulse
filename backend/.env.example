# Jan-Pulse Backend Environment Variables
# Copy to backend/.env or set in cloud environment dashboard

# Supabase
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_JWT_SECRET=

# Groq API
GROQ_API=gsk_....
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Google Gemini API
GEMINI_API=AIza...
GEMINI_MODEL_LONG=models/gemini-3.8-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# Official Data Portals
MYSCHEME_API_KEY=tYTy5eEhlu9rFjyxuCr7ra7ACp4dv1RH8gWuHTDc
DATA_GOV_IN_API_KEY=
