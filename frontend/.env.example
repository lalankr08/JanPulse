# Jan-Pulse Frontend Environment Variables
# Copy to frontend/.env.local or set in Vercel project settings

# Backend API Endpoint (Local: http://localhost:8000 | Production: https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
